{
  "$defs": {
    "ProductionMotion": {
      "enum": [
        "static",
        "slow_pan_down",
        "static_focus"
      ],
      "title": "ProductionMotion",
      "type": "string"
    },
    "Region": {
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Y Max",
          "type": "number"
        }
      },
      "title": "Region",
      "type": "object"
    },
    "VisualRole": {
      "enum": [
        "show",
        "context_only",
        "omit_visual"
      ],
      "title": "VisualRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "shot_id": {
      "minLength": 1,
      "title": "Shot Id",
      "type": "string"
    },
    "segment_id": {
      "minLength": 1,
      "title": "Segment Id",
      "type": "string"
    },
    "source_panel_id": {
      "minLength": 1,
      "title": "Source Panel Id",
      "type": "string"
    },
    "substitute_panel_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Substitute Panel Id"
    },
    "source_box": {
      "$ref": "#/$defs/Region"
    },
    "focus_regions": {
      "items": {
        "$ref": "#/$defs/Region"
      },
      "title": "Focus Regions",
      "type": "array"
    },
    "avoid_regions": {
      "items": {
        "$ref": "#/$defs/Region"
      },
      "title": "Avoid Regions",
      "type": "array"
    },
    "visual_role": {
      "$ref": "#/$defs/VisualRole",
      "default": "show"
    },
    "visual_omit_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visual Omit Reason"
    },
    "substitution_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Substitution Reason"
    },
    "motion_type": {
      "$ref": "#/$defs/ProductionMotion",
      "default": "static"
    },
    "scroll_fraction_per_second": {
      "default": 0,
      "maximum": 0.12,
      "minimum": 0,
      "title": "Scroll Fraction Per Second",
      "type": "number"
    },
    "duration_sec": {
      "exclusiveMinimum": 0,
      "title": "Duration Sec",
      "type": "number"
    }
  },
  "required": [
    "shot_id",
    "segment_id",
    "source_panel_id",
    "duration_sec"
  ],
  "title": "Shot",
  "type": "object"
}
