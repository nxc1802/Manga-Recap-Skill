# ==============================================================================
# Manga Recap Skill — Runtime & Provider Environment Configuration
# Copy to .env and fill in only the credentials needed for your workflow.
# Precedence: CLI arguments / explicit API args > environment variables > config.yaml > defaults
# ==============================================================================

# Local Storage & Paths
MANGA_RECAP_DATA_DIR=data
MANGA_RECAP_OUTPUT_DIR=output
YOUTUBE_ACCOUNTS_DIR=data/youtube_accounts

# Logging
LOG_LEVEL=INFO

# Local VieNeu-TTS v3 Turbo Engine
# Device options: mps (Apple Silicon), cuda (NVIDIA GPU), cpu
VIENEU_DEVICE=mps
VIENEU_SAMPLE_RATE=48000

# Gemini Decision API (closed-set panel routing via `decide`)
# GEMINI_API_KEY=

# Kaggle Cloud GPU (or configure via `manga-recap cloud accounts`)
# KAGGLE_API_TOKEN=

# Private Hugging Face Archive (`manga-recap archive push|verify|restore`)
# HF_TOKEN=
