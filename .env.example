# ==============================================================================
# MANGA RECAP AGENTIC SKILL V3 CONFIGURATION
# Local-First, Zero Cloud LLM/TTS, Offline VieNeu-TTS v3 Turbo Architecture
# ==============================================================================

# LOCAL AUDIO ENGINE SETTINGS (VieNeu-TTS v3 Turbo)
# Backend device options: mps (Apple Silicon Metal), cuda (NVIDIA GPU), cpu
VIENEU_DEVICE=mps
VIENEU_SAMPLE_RATE=48000

# LOCAL STORAGE DIRECTORY (Default: data/projects)
STORAGE_DIR=data/projects

# LOGGING LEVEL (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

