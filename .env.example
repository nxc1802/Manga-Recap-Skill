# ==============================================================================
# MANGA RECAP PIPELINE ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env and fill in the values before running the pipeline.
# ==============================================================================

# CẤU HÌNH API OPENROUTER (Dùng cho LLM/VLM dịch và viết kịch bản)
# Lấy API key từ: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# CẤU HÌNH SUPABASE (Dùng cho việc lưu trữ trạng thái panels/scripts/audio)
# Lấy thông tin URL & Keys trong Project Settings -> API của dự án Supabase.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# CẤU HÌNH API CLOUD TTS (TÙY CHỌN - Edge-TTS mặc định hoàn toàn miễn phí không cần API key)
# GOOGLE_API_KEY: Dùng cho Gemini TTS API
GOOGLE_API_KEY=
# OPENAI_API_KEY: Dùng cho OpenAI TTS API
OPENAI_API_KEY=

# CẤU HÌNH YOUTUBE DATA API V3
# YOUTUBE_CLIENT_SECRETS_FILE: Tệp client_secrets.json tải về từ Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
# YOUTUBE_CREDENTIALS_FILE: Tệp token lưu trữ phiên đăng nhập được sinh ra tự động sau lần chạy đầu tiên
YOUTUBE_CREDENTIALS_FILE=.youtube_token.json
